{
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/bun.lock": true
  },
  "workbench.colorTheme": "Houston",
  "editor.defaultFormatter": "biomejs.biome",
  "prettier.documentSelectors": ["**/*.astro", "**/*.css", "**/*.pcss"],
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[postcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
