---
import { Image, Picture } from "astro:assets";

interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;

import pic from "./pic.png";
import transparentBadge from "./transparent-badge.png";
---

<div class="card">
  <h1>{title}</h1>
  <p>{body}</p>
  <div class="pics">
    <Image
      src={pic}
      alt="A description of my image."
      layout="constrained"
      fit="cover"
      position="top"
      width={200}
      height={200}
      priority
    />
    <Picture
      src={pic}
      alt="A description of my image."
      layout="constrained"
      fit="cover"
      position="top"
      width={200}
      height={200}
      formats={["avif", "webp"]}
      priority
    />
    <Picture
      src={pic}
      alt="A description of my image."
      width={200}
      height={200}
      formats={["avif", "webp"]}
      densities={[2, 3]}
      loading={"eager"}
      decoding={"sync"}
      fetchpriority={"high"}
    />
    {/* JPEG has no transparency, so background fills the badge's clear corners. */}
    <Image
      src={transparentBadge}
      alt="Purple badge with a white check mark"
      format="jpeg"
      background="#f2e9ff"
      width={200}
      height={200}
    />
  </div>
</div>

<style>
  h1 {
    font-size: var(--step-5);
  }

  .pics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 1rem;
  }
</style>
